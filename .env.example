# Leave STATION_HOST empty to run in MockStationBridge offline mode
STATION_HOST=127.0.0.1
STATION_PORT=8888

# Pin follower bus serial when BOTH leader & follower are plugged in
STATION_BUS_SERIAL=

# Substrings of camera unique_ids from scripts/probe_station.py
CAMERA_TOP=
CAMERA_WRIST=

# Optional AI API keys
GEMINI_API_KEY=
ROBO_JEV_API_KEY=
# TypeSafe Jev (System One) API key from https://console.typesafe.ai/keys
TYPE_SAFE_API_KEY=

# --- Optional desk_core tuning (defaults shown; leave unset to accept) -----
# Creep limit per move_joints call (encoder ticks):
# ROBOT_MAX_STEP_TICKS=400
# Auto-resubscribe NormFS streams after this much telemetry silence (s):
# ROBOT_STALE_RESUB_S=8
# Refuse motion/E-STOP commands when newest telemetry is older than this (s):
# ROBOT_MAX_CMD_STALE_S=10
# Motor count (8 = ElRobot 7 arm + gripper; 6 = SO-101 5 arm + gripper):
# ROBOT_NUM_MOTORS=8
# Optional URL if Pink IK runs as a remote HTTP service:
# PINK_IK_URL=
# Path to rig calibration JSON (default: calib/rig_calib.json):
# DESK_CALIB_PATH=
# Tool-call replay logging into runs/<UTC ts>/calls.jsonl (0 = off):
# DESK_RUNLOG=1
# DESK_RUNS_DIR=            # override log root (default: <repo>/runs)
# Sightings history store (NormFS primary with SQLite fallback):
# DESK_SIGHTINGS_NORMFS=1   # set 0 to force SQLite fallback
# DESK_SIGHTINGS_QUEUE=desk_core/sightings
# DESK_SIGHTINGS_DB=        # override SQLite fallback path (default: station_data/sightings.db)
# Mission Control dashboard (binds 127.0.0.1 by default; a non-loopback DASHBOARD_HOST requires DASHBOARD_TOKEN):
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_TOKEN=
# Non-loopback also needs TLS (DASHBOARD_SSL_CERTFILE / DASHBOARD_SSL_KEYFILE) or DASHBOARD_ALLOW_HTTP=1:
# DASHBOARD_SSL_CERTFILE=
# DASHBOARD_SSL_KEYFILE=
# TRAC-IK per-query time budget in seconds:
# DESK_IK_TIMEOUT_S=0.02
